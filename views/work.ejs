<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<%- include('partials/nav') %>

<main id="main">

  <section class="hero hero--page" style="background:var(--charcoal);">
    <div class="container hero__content">
      <div class="eyebrow">AMP Titans Automations</div>
      <h1 class="h1">Two products. Zero spreadsheets left behind.</h1>
      <p class="hero__sub"><%= site.parentCompany.description %></p>
    </div>
  </section>

  <% site.businesses.forEach(function(biz, i) { %>
  <section id="<%= biz.slug %>" class="section <%= i % 2 === 0 ? 'section--light' : 'section--dark section--line-top' %>">
    <div class="container">
      <div class="work-card <%= i % 2 === 0 ? '' : 'card--dark' %>" style="background:transparent; border:none; display:block;">
        <div class="split <%= i % 2 === 1 ? 'split--reverse' : '' %>">
          <div class="split__media">
            <div class="logo-badge" style="margin-bottom:24px;"><img src="<%= biz.logo %>" alt="<%= biz.name %> logo" style="height:28px;"></div>
            <div class="work-card__status">Live product</div>
            <h2 class="h2"><%= biz.name %></h2>
            <p class="lede" style="margin-bottom:20px;"><%= biz.oneLiner %></p>
            <div class="work-card__tags">
              <% biz.tags.forEach(function(tag) { %><span class="tag"><%= tag %></span><% }) %>
            </div>
            <div class="btn-row" style="margin-top:24px;">
              <a href="<%= biz.url %>" target="_blank" rel="noopener" class="btn btn-primary">Visit <%= biz.name %> →</a>
            </div>
          </div>
          <div>
            <div class="card <%= i % 2 === 1 ? 'card--dark' : '' %>">
              <div class="card__corner"></div>
              <h4 class="small" style="text-transform:uppercase; letter-spacing:0.08em; color:var(--copper); font-weight:700; margin-bottom:10px;">The problem</h4>
              <p style="margin-bottom:22px;"><%= biz.problem %></p>
              <h4 class="small" style="text-transform:uppercase; letter-spacing:0.08em; color:var(--copper); font-weight:700; margin-bottom:10px;">What I built</h4>
              <p style="margin-bottom:22px;"><%= biz.solution %></p>
              <h4 class="small" style="text-transform:uppercase; letter-spacing:0.08em; color:var(--copper); font-weight:700; margin-bottom:10px;">Who it helps</h4>
              <p style="margin-bottom:22px;"><%= biz.who %></p>
              <h4 class="small" style="text-transform:uppercase; letter-spacing:0.08em; color:var(--copper); font-weight:700; margin-bottom:10px;">Highlights</h4>
              <ul class="work-card__list">
                <% biz.results.forEach(function(r) { %><li><%= r %></li><% }) %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% }) %>

  <section class="section section--light section--line-top">
    <div class="container center" style="max-width:640px;">
      <div class="eyebrow center">Have a project in mind</div>
      <h2 class="h2">Curious how either product was built, or have feedback?</h2>
      <p class="lede center" style="margin: 0 auto 28px;">I'd like to hear from you — reach out and I'll get back to you personally.</p>
      <a href="/contact" class="btn btn-primary">Get in touch</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
</body>
</html>

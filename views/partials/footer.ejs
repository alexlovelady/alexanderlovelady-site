<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__logo">Alexander <span>Lovelady</span></div>
        <p class="small" style="max-width:38ch;">Automation developer, founder, Navy veteran, and competitive bull rider based near <%= site.location %>.</p>
      </div>
      <div>
        <h4>Site</h4>
        <ul class="footer__links">
          <li><a href="/work">Work</a></li>
          <li><a href="/bull-riding">Bull Riding</a></li>
          <li><a href="/sponsors">Sponsors</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Connect</h4>
        <ul class="footer__links">
          <li><a href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a></li>
          <li><a href="tel:<%= site.contact.phoneHref %>"><%= site.contact.phone %></a></li>
          <li><a href="<%= site.social.tiktokUrl %>" target="_blank" rel="noopener">TikTok @<%= site.social.tiktokHandle %></a></li>
          <li><a href="<%= site.social.youtubeUrl %>" target="_blank" rel="noopener">YouTube <%= site.social.youtubeHandle %></a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; <%= currentYear %> Alexander Lovelady. All rights reserved.</span>
      <span>Built by AMP Titans Automations.</span>
    </div>
  </div>
</footer>
<script src="/js/main.js"></script>

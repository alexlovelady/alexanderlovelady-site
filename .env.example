# Copy this file to .env for local development.
# On Railway, set these as project Variables instead of committing a .env file.

PORT=3000
SITE_URL=https://alexanderlovelady.com

# Contact form delivery (https://resend.com) — free tier is plenty for a personal site.
RESEND_API_KEY=
CONTACT_TO_EMAIL=alexander.s.lovelady@gmail.com
CONTACT_FROM_EMAIL=Alexander Lovelady Site <onboarding@resend.dev>

# YouTube subscriber count: works out of the box via a best-effort scrape of the
# public channel page (same approach as TikTok below), no key needed. If YouTube
# ever changes their page markup and that breaks, get a free API key at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3")
# and set it here for a more reliable source — the site prefers this automatically
# when it's set, and falls back to scraping if the API call ever fails.
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=@alexanderlovelady

# TikTok has no public follower-count API. The site does a best-effort read of the
# public profile page; if that ever breaks (TikTok changes their markup), set a
# manual fallback number here so the widget still shows something reasonable.
TIKTOK_USERNAME=alexanderlovelady
TIKTOK_FALLBACK_FOLLOWERS=
